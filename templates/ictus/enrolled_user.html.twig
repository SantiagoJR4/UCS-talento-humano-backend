<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"></head>
<body style="margin:0; padding:20px; background-color:#f4f7f5; font-family:Arial,sans-serif;">

<table width="600" cellpadding="0" cellspacing="0" style="margin:0 auto; background:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #c8e6d5;">

  {# ── Header ── #}
  <tr>
    <td style="background:#1a5c38; padding:28px 32px 22px;">
      <p style="margin:0 0 6px; font-size:11px; color:#a8d5b8; letter-spacing:0.08em; text-transform:uppercase;">Fundación Universitaria Católica del Sur</p>
      <p style="margin:0; font-size:22px; font-weight:bold; color:#ffffff;">Nuevo Inscrito</p>
    </td>
  </tr>

  {# ── Admitted badge ── #}
  <tr>
    <td style="background:#f0f8f3; border-bottom:1px solid #c8e6d5; padding:12px 32px;">
      <span style="display:inline-block; background:#d4edde; border:1px solid #a8d5b8; border-radius:20px; padding:5px 16px; font-size:13px; font-weight:bold; color:#1a5c38;">
        &#10003;&nbsp; Nuevo Usuario Inscrito
      </span>
    </td>
  </tr>

  {# ── User info ── #}
  <tr>
    <td style="padding:24px 32px 8px;">
      <p style="margin:0 0 12px; font-size:11px; color:#6b7c6f; text-transform:uppercase; letter-spacing:0.07em;">Datos del Usuario</p>
      <table width="100%" cellpadding="0" cellspacing="0">
        <tr style="border-bottom:1px solid #e8f0eb;">
          <td style="padding:9px 0; font-size:13px; color:#6b7c6f; width:140px;">Inscripción</td>
          <td style="padding:9px 0; font-size:14px; font-weight:bold; color:#1a2e22;">{{ oferta }}</td>
        </tr>
        <tr style="border-bottom:1px solid #e8f0eb;">
          <td style="padding:9px 0; font-size:13px; color:#6b7c6f;">Nombre completo</td>
          <td style="padding:9px 0; font-size:14px; font-weight:bold; color:#1a2e22;">{{ nombres }} {{ apellidos }}</td>
        </tr>
        <tr>
          <td style="padding:9px 0; font-size:13px; color:#6b7c6f;">Documento</td>
          <td style="padding:9px 0; font-size:14px; font-weight:bold; color:#1a2e22;">{{ tipoIdentificacion }} {{ numero }}</td>
        </tr>
      </table>
    </td>
  </tr>

  {# ── Address & contact ── #}
  <tr>
    <td style="padding:20px 32px 8px;">
      <p style="margin:0 0 4px; font-size:11px; color:#6b7c6f; text-transform:uppercase; letter-spacing:0.07em;">Correo del Usuario</p>
      <p style="margin:0 0 16px; font-size:13px; color:#3d4f45; line-height:1.6;">
        &#128231; {{ correo }}
      </p>
      <p style="margin:0 0 4px; font-size:11px; color:#6b7c6f; text-transform:uppercase; letter-spacing:0.07em;">Celular del Usuario</p>
      <p style="margin:0; font-size:13px; color:#3d4f45; line-height:1.6;">
        &#128241; {{ telefono }}
      </p>
    </td>
  </tr>

  {# ── Notice ── #}
  <tr>
    <td style="padding:16px 32px 24px;">
      <div style="background-color:#fff9e6; border:1px solid #ffe58f; border-radius:6px; padding:12px 16px; font-size:13px; color:#8a6d3b; line-height:1.5;">
        <strong>Nota importante:</strong> Recuerda que la inscripción no quiere decir que el pago haya sido realizado.
      </div>
    </td>
  </tr>

</table>
</body>
</html>